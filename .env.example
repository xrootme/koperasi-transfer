# AI Vision — provider
#   gemini -> Google Gemini (default, butuh API key)
#   local  -> Hermes / llama.cpp / Ollama / vLLM (OpenAI-compatible)

# --- Gemini (default) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=isi_dengan_API_key_Anda

GEMINI_MODEL=gemini-3.8-flash

# --- Model lokal (hanya dipakai bila AI_PROVIDER=local) ---
# llama.cpp server  : http://127.0.0.1:8080/v1
# Hermes (vLLM)     : http://127.0.0.1:8000/v1
# Ollama            : http://127.0.0.1:11434/v1
# LOCAL_AI_URL=http://127.0.0.1:8080/v1
# LOCAL_AI_MODEL=hermes
# LOCAL_AI_API_KEY=
# LOCAL_AI_TIMEOUT_MS=120000
# LOCAL_AI_RESPONSE_FORMAT=json_object
SPREADSHEET_ID=1100KDBK1QsidsaZfzKLEoGiNPg-bkV3trTkhdqyAYSY
SHEET_NAME=Remider Angsuran
CRON_SCHEDULE=0 9 * * *
TIMEZONE=Asia/Jakarta
DELAY_MS=3000
# --- Simpan gambar bukti sebelum dikirim ke AI ---
BUKTI_DIR=bukti
BUKTI_SAVE=true
BUKTI_DEDUP=true
BUKTI_MAX_AGE_DAYS=30
