# ============================================================================
# Konfigurasi Inti - salin file ini jadi .env lalu isi nilai aslinya
#   cp .env.example .env
# ============================================================================

# --- Google Sheets ---
SPREADSHEET_ID=isi_dengan_id_spreadsheet_Anda
SHEET_NAME=Remider Angsuran

# --- Admin WhatsApp ---
# Nomor yang boleh memakai perintah CRUD. Boleh nomor HP atau LID.
# Pisahkan dengan koma kalau lebih dari satu, contoh: 628xxxxxxxxx,186xxxxxxxx
ADMIN_NUMBERS=isi_dengan_nomor_admin_Anda

# --- Jadwal & Zona Waktu ---
CRON_SCHEDULE=0 9 * * *
TIMEZONE=Asia/Jakarta
DELAY_MS=3000

# --- Aturan Verifikasi ---
# true  = bukti transfer hanya auto-update pada hari jadwal anggota
# false = boleh auto-update kapan saja (kurang disarankan)
STRICT_HARI=true
USE_GROUP_SHEETS=true

# Toleransi selisih nominal saat mencocokkan bukti transfer.
# 0 = nominal harus sama persis. Naikkan hanya kalau sering terjadi selisih pembulatan.
NOMINAL_TOLERANCE=0

# Nama sheet untuk antrean review & riwayat transaksi (dibuat otomatis bila belum ada)
REVIEW_SHEET=Review
TRANSAKSI_SHEET=Transaksi

# --- AI Vision ---
# gemini -> Google Gemini (default, butuh API key)
# local  -> Hermes / llama.cpp / Ollama / vLLM (OpenAI-compatible)
AI_PROVIDER=gemini
GEMINI_API_KEY=isi_dengan_API_key_Anda
# gemini-2.5-flash sudah tidak tersedia untuk user baru -> jangan dipakai
GEMINI_MODEL=gemini-3.8-flash

# --- Model lokal (hanya bila AI_PROVIDER=local) ---
# llama.cpp server : http://127.0.0.1:8080/v1
# Hermes (vLLM)    : http://127.0.0.1:8000/v1
# Ollama           : http://127.0.0.1:11434/v1
# LOCAL_AI_URL=http://127.0.0.1:8080/v1
# LOCAL_AI_MODEL=hermes
# LOCAL_AI_API_KEY=
# LOCAL_AI_TIMEOUT_MS=120000
# LOCAL_AI_RESPONSE_FORMAT=json_object

# --- Bukti Transfer (penyimpanan & anti-duplikat) ---
BUKTI_DIR=bukti
BUKTI_SAVE=true
BUKTI_DEDUP=true
BUKTI_MAX_AGE_DAYS=30
