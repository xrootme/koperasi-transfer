# ============================================================================
# AI Vision — provider
#   AI_PROVIDER=local  -> Hermes / llama.cpp / Ollama / vLLM (OpenAI-compatible)
#   AI_PROVIDER=gemini -> Google Gemini (cloud, butuh API key)
# ============================================================================
AI_PROVIDER=local

# --- Model lokal (dipakai saat AI_PROVIDER=local) ---
# llama.cpp server  : http://127.0.0.1:8080/v1
# Hermes (vLLM)     : http://127.0.0.1:8000/v1
# Ollama            : http://127.0.0.1:11434/v1
LOCAL_AI_URL=http://127.0.0.1:8080/v1
LOCAL_AI_MODEL=hermes
# Kosongkan kalau server tidak minta autentikasi
LOCAL_AI_API_KEY=
LOCAL_AI_TIMEOUT_MS=120000
# json_object = paksa output JSON | none = biarkan bebas
LOCAL_AI_RESPONSE_FORMAT=json_object

# --- Gemini (hanya dipakai saat AI_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash